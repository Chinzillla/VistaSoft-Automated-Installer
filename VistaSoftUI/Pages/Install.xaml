<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VistaSoftUI.Pages.Install"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VistaSoftUI.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        
        <Grid Padding="32" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <!-- Left half -->
            <Grid Grid.Column="0" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock
                Grid.Row="0"
                Text="Options"
                FontSize="24"
                FontWeight="SemiBold" />

                <!-- Content -->
                <StackPanel Grid.Row="2" Spacing="12">
                    <Button Content="Import Options" />
                    <CheckBox x:Name="ConnectModeCheckBox" Content="VistaSoft Connect" />
                    <TextBlock Text="Installation Type" />
                    <RadioButton
                            x:Name="LocalRadioButton"
                            Content="Local"
                            GroupName="InstallType"
                            IsChecked="True"/>
                    <RadioButton
                            x:Name="ClientRadioButton"
                            Content="Client"
                            GroupName="InstallType"/>
                    <RadioButton
                            x:Name="ServerRadioButton"
                            Content="Server"
                            GroupName="InstallType"/>
                    <TextBox
                        x:Name="ServerHostTextBox"
                        Header="Server Host Name"
                        IsEnabled="False"
                        PlaceholderText="example-server:3113" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="DatabasePathTextBox"
                            Grid.Column="0"
                            Header="Database Path"
                            PlaceholderText="C:\VistaSoftData" />
                        <Button
                            Grid.Column="1"
                            Content="Browse"
                            VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBox x:Name="PracticeNameTextBox" Header="Practice Name" />

                    <TextBox x:Name="StreetTextBox" Header="Street" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="CityTextBox" Grid.Column="0" Header="City" />
                        <TextBox x:Name="StateTextBox" Grid.Column="1" Header="State / Province" />
                        <TextBox x:Name="ZipTextBox" Grid.Column="2" Header="Zip / Postal Code" />
                    </Grid>

                    <ComboBox x:Name="CountryComboBox" Header="Country" Width="220" SelectedIndex="0">
                        <ComboBoxItem Content="United States" />
                        <ComboBoxItem Content="Canada" />
                    </ComboBox>
                    <TextBlock
                        Text="Devices"
                        FontWeight="SemiBold" />
                    <CheckBox x:Name="ScanXCheckBox" Content="ScanX" />
                    <CheckBox x:Name="ScanXClassicCheckBox" Content="ScanX Classic" />
                    <CheckBox x:Name="CamXCheckBox" Content="CamX" />
                    <CheckBox x:Name="SensorXCheckBox" Content="SensorX" />
                    <CheckBox x:Name="TwainCheckBox" Content="Twain" />
                    <Button Content="Export Options" />
                </StackPanel>
            </Grid>

            <!-- Right half -->
            <Grid Grid.Column="1" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                Grid.Row="0"
                Text="Install VistaSoft"
                FontSize="24"
                FontWeight="SemiBold" />

                <StackPanel Grid.Row="2" Spacing="12">
                    <Button Content="Open VistaSoft iso" />
                    <Button Content="Install" />
                </StackPanel>
            </Grid>
            
        </Grid>
    </ScrollViewer>
</Page>
